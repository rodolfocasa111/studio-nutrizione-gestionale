# Copiare in .streamlit/secrets.toml (ignorato da git) o incollare nei Secrets di Streamlit Cloud.
# NESSUN valore ha piu' un default nel codice: se manca un campo obbligatorio l'app non parte.

[supabase]
url = "https://<progetto>.supabase.co"
key = "<service_role key>"          # NON la publishable/anon key: vedi db/migrazione_sicurezza.sql

[auth]
admin_user = "..."
admin_password = "..."              # lunga e unica
consenti_accesso_senza_pin = true   # portare a false quando tutti i pazienti hanno un PIN

[google]
calendar_id = "<calendario>@gmail.com"   # il calendario va condiviso con l'account di servizio (modifica eventi)

[gcp_service_account]               # contenuto del JSON dell'account di servizio (al posto di credentials.json)
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "..."
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"

[gemini]
api_key = ""
model = "gemini-2.5-flash"          # verificare il nome del modello disponibile per il proprio account

[studio]                            # intestazione delle fatture
nome = "STUDIO DI NUTRIZIONE CLINICA"
titolare = "Dott. ..."
partita_iva = ""
codice_fiscale = ""
indirizzo = ""
iscrizione_albo = ""
